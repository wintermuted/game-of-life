{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "lint": {
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/.oxlintrc.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/.gitignore"
      ],
      "cache": true
    }
  },
  "defaultBase": "main"
}
