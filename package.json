{
  "name": "game-of-life",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "homepage": "https://wintermuted.github.io/game-of-life",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "nx run @game-of-life/app:dev",
    "start": "nx run @game-of-life/app:dev",
    "build": "nx run-many --target=build --all",
    "build:app": "nx run @game-of-life/app:build",
    "build:ui": "nx run-many --target=build --projects=@game-of-life/ui,@game-of-life/ui-grid,@game-of-life/ui-patterns,@game-of-life/ui-controls",
    "preview": "nx run @game-of-life/app:preview",
    "lint": "nx run-many --target=lint --projects=@game-of-life/app,@game-of-life/ui,@game-of-life/ui-grid,@game-of-life/ui-patterns,@game-of-life/ui-controls,@game-of-life/core,@game-of-life/api,@game-of-life/util",
    "test": "nx run-many --target=test --all",
    "test:watch": "nx run @game-of-life/app:test:watch",
    "test:ui": "nx run @game-of-life/app:test:ui",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@nx/js": "24.0.6",
    "@nx/vite": "24.0.6",
    "@nx/workspace": "24.0.6",
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/ui": "5.1.0",
    "jsdom": "^31.0.1",
    "nx": "24.0.6",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "sass": "^1.108.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "5.1.0"
  }
}
