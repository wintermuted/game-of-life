{
  "name": "@game-of-life/api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/api/src",
  "projectType": "library",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run lint", "cwd": "packages/api" }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "cache": false,
      "dependsOn": ["^build"],
      "options": { "command": "npm run build", "cwd": "packages/api" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run", "cwd": "packages/api" }
    }
  },
  "tags": ["type:lib", "scope:api"]
}
